Date: Sat, 31 Oct 2026 06:42:15 +0000
Subject: [PATCH 3/4] Tests: skip cleanly when bindings or the migration script
 are absent

- test_glass: skip the module when pycairo/PyGObject are not installed instead of
  failing at import (any other import error still fails).
- test_cleaner: skip the migration test while tools/migrate-home-storage.py does not
  exist; the repo only ships migrate-home-storage.sh.
---
 tests/test_cleaner.py |  2 ++
 tests/test_glass.py   | 11 ++++++++---
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/tests/test_cleaner.py b/tests/test_cleaner.py
index e031c55..bbaacd3 100644
--- a/tests/test_cleaner.py
+++ b/tests/test_cleaner.py
@@ -51,6 +51,8 @@ class CleanerTests(unittest.TestCase):
                 self.assertIn('Skipped', run_cleaner(True, home=home))
             self.assertTrue((cache / 'keep').exists())
 
+    @unittest.skipUnless((Path(__file__).parents[1] / 'tools/migrate-home-storage.py').exists(),
+                         'tools/migrate-home-storage.py is not in the repository (only the .sh version is)')
     def test_migration_checksums_and_idempotence(self):
         spec = importlib.util.spec_from_file_location('migration', Path(__file__).parents[1] / 'tools/migrate-home-storage.py')
         module = importlib.util.module_from_spec(spec)
diff --git a/tests/test_glass.py b/tests/test_glass.py
index 4c6fe46..b3b7bf3 100644
--- a/tests/test_glass.py
+++ b/tests/test_glass.py
@@ -3,9 +3,14 @@ import tempfile
 import sys
 import unittest
 
-import cairo
-
-from wallpaper_studio.glass import WallpaperGlass, gaussian_blur, gaussian_kernel
+try:
+    import cairo
+    from wallpaper_studio.glass import WallpaperGlass, gaussian_blur, gaussian_kernel
+except ModuleNotFoundError as error:
+    # Skip only when the system bindings are absent; any other import error should still fail.
+    if error.name not in ("cairo", "gi"):
+        raise
+    raise unittest.SkipTest(f"{error.name} is not installed")
 
 
 class WallpaperGlassTests(unittest.TestCase):
