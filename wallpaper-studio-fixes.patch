From fb031223e48301f3f1dcbb798c6256b3c8d53f77 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 06:42:15 +0000
Subject: [PATCH 2/4] Lock overlay: constant-time compare, drop dead imports,
 say what it is

- Compare the entered password with hmac.compare_digest (on bytes, so non-ASCII
  passwords work) instead of ==.
- Remove the duplicated 'from . import storage' and the unused hashlib/time imports.
- The overlay is an ordinary fullscreen window, not a session lock. Say so in the
  module docstring, the setting description and the GUI subtitle, and point to
  loginctl lock-session for real protection.
---
 wallpaper_studio/app.py        |  2 +-
 wallpaper_studio/lockscreen.py | 13 ++++++++-----
 wallpaper_studio/settings.py   |  2 +-
 3 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/wallpaper_studio/app.py b/wallpaper_studio/app.py
index 114ee8e..461d92f 100644
--- a/wallpaper_studio/app.py
+++ b/wallpaper_studio/app.py
@@ -263,7 +263,7 @@ class Window(Adw.ApplicationWindow):
         method.connect("notify::selected", lambda c, _p: self.save(awake_method="mouse" if c.get_selected() == 0 else "inhibit"))
         self.awake_method_combo = method
         screen.add(method)
-        password = Adw.ActionRow(title="Lock-screen password", subtitle="Leave empty to disable the themed lock overlay")
+        password = Adw.ActionRow(title="Lock-screen password", subtitle="Cover-only overlay, not a secure lock. Leave empty to disable")
         password_entry = Gtk.Entry(text=self.config["lock_password"], visibility=False, placeholder_text="Password",
                                    valign=Gtk.Align.CENTER, width_chars=18)
         password_entry.connect("activate", lambda entry: self.save(lock_password=entry.get_text()))
diff --git a/wallpaper_studio/lockscreen.py b/wallpaper_studio/lockscreen.py
index 0e17da5..138506e 100644
--- a/wallpaper_studio/lockscreen.py
+++ b/wallpaper_studio/lockscreen.py
@@ -1,7 +1,11 @@
-"""A small, theme-aware lock overlay for kiosk and presentation use."""
-import hashlib
-import time
+"""A small, theme-aware cover overlay for kiosk and presentation use.
+
+This is an ordinary fullscreen window, not a session lock: it does not stop
+VT switching, killing the process, or other ways around it. Use the desktop's own
+lock (for example ``loginctl lock-session``) when real protection is needed.
+"""
 import fcntl
+import hmac
 
 import gi
 gi.require_version("Gdk", "3.0")
@@ -11,7 +15,6 @@ from gi.repository import Gdk, GdkPixbuf, GLib, Gtk
 
 from . import core
 from . import storage
-from . import storage
 
 
 class LockScreen:
@@ -95,7 +98,7 @@ class LockScreen:
 
     def unlock(self, *_args):
         expected = core.load_config().get("lock_password", "")
-        if expected and self.entry.get_text() == expected:
+        if expected and hmac.compare_digest(self.entry.get_text().encode(), expected.encode()):
             self.window.hide()
             self.window.destroy()
             fcntl.flock(self.lock_file, fcntl.LOCK_UN)
diff --git a/wallpaper_studio/settings.py b/wallpaper_studio/settings.py
index 42ebd6d..7907e5f 100644
--- a/wallpaper_studio/settings.py
+++ b/wallpaper_studio/settings.py
@@ -42,7 +42,7 @@ DESCRIPTIONS = {
     "glass": "Transparent app windows",
     "terminal": "Recolour GNOME Terminal",
     "lock_screen": "Update the lock-screen picture",
-    "lock_password": "Password for Wallpaper Studio's optional lock overlay (empty disables it)",
+    "lock_password": "Password for the optional cover overlay; not a secure session lock (empty disables it)",
     "clock": "Show the desktop clock",
     "clock_format": "strftime time format",
     "clock_date_format": "strftime date format; empty hides the date",
