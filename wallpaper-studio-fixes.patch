From 923bb4dbc2fbd6a35a18e22ec6225b6a19c8d415 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 06:42:15 +0000
Subject: [PATCH 1/4] Fix TUI crash on Widgets page and stop echoing the lock
 password

tui.LABELS had no entry for lock_password, so opening the Widgets panel raised
KeyError (this broke three TUI tests). Add the label.

Panel.preference() also rendered every value with str(), so a configured lock
password was drawn in clear text on a shared screen. Route display through a small
display_value() helper that masks secrets as (set)/(not set).

Add regression tests: every described setting must have a panel label, and
secrets are never displayed.
---
 tests/test_tui.py       | 19 ++++++++++++++++++-
 wallpaper_studio/tui.py | 16 +++++++++++-----
 2 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/tests/test_tui.py b/tests/test_tui.py
index 00ade11..9a38bc4 100644
--- a/tests/test_tui.py
+++ b/tests/test_tui.py
@@ -15,7 +15,7 @@ import unittest
 from unittest.mock import patch
 
 from wallpaper_studio import media, storage
-from wallpaper_studio.tui import CommandJob, awake_status
+from wallpaper_studio.tui import CommandJob, awake_status, display_value
 
 ROOT = Path(__file__).resolve().parents[1]
 
@@ -36,6 +36,23 @@ class TerminalBackendTests(unittest.TestCase):
         for key in ("layout_grid", "layout_grid_size", "layout_grid_gap"):
             self.assertTrue(any(row.setting == key for row in rows))
 
+    def test_every_described_setting_has_a_panel_label(self):
+        # Panel.preference() indexes LABELS and DESCRIPTIONS by key; a missing label crashes the TUI.
+        from wallpaper_studio import settings
+        from wallpaper_studio.tui import LABELS
+        self.assertEqual(set(settings.DESCRIPTIONS) - set(LABELS), set())
+
+    def test_secret_settings_are_never_displayed(self):
+        self.assertEqual(display_value("lock_password", "hunter2"), "(set)")
+        self.assertEqual(display_value("lock_password", ""), "(not set)")
+        self.assertNotIn("hunter2", display_value("lock_password", "hunter2"))
+
+    def test_ordinary_settings_display_as_before(self):
+        self.assertEqual(display_value("clock", True), "On")
+        self.assertEqual(display_value("clock", False), "Off")
+        self.assertEqual(display_value("clock_format", "%H:%M"), "%H:%M")
+        self.assertEqual(display_value("clock_date_format", ""), "(hidden)")
+
     def test_expired_awake_requests_display_off(self):
         self.assertEqual(awake_status({}, now=100), "Off")
         self.assertEqual(awake_status({"until": 99}, now=100), "Off")
diff --git a/wallpaper_studio/tui.py b/wallpaper_studio/tui.py
index 474fcfe..9c00a33 100644
--- a/wallpaper_studio/tui.py
+++ b/wallpaper_studio/tui.py
@@ -25,8 +25,18 @@ LABELS = {
     "layout_grid_gap": "Grid spacing (px)",
     "widget_blur": "Frosted widget glass", "widget_blur_radius": "Glass blur radius",
     "logtime_username": "Logtime username", "logtime_goal": "Logtime goal (hours)",
+    "lock_password": "Lock overlay password",
 }
 CHOICES = {"mode": ("light", "dark", "auto"), "awake_method": ("mouse", "inhibit")}
+SECRETS = frozenset({"lock_password"})
+
+
+def display_value(key, value):
+    """Text shown for a setting. Secrets are never echoed to a shared screen."""
+    if key in SECRETS:
+        return "(set)" if value else "(not set)"
+    display = ("On" if value else "Off") if isinstance(value, bool) else str(value)
+    return display or "(hidden)"
 
 
 @dataclass
@@ -126,11 +136,7 @@ class Panel:
         self.refresh_at = time.monotonic() + 1
 
     def preference(self, key):
-        value = self.config[key]
-        display = ("On" if value else "Off") if isinstance(value, bool) else str(value)
-        if display == "":
-            display = "(hidden)"
-        return Item(LABELS[key], display, settings.DESCRIPTIONS[key], setting=key)
+        return Item(LABELS[key], display_value(key, self.config[key]), settings.DESCRIPTIONS[key], setting=key)
 
     def items(self):
         if self.page == 0:
-- 
